{
  "id": "mixed-sandboxes",
  "comment": "三档沙箱混合教学示例:clean(python)走 dify 档(远程沙箱服务)、score(js)走 docker 档(一次性容器)、reply(php)走 process 档(进程级)。同一工作流内三档并存,快照 timeCost 直接对比各档耗时。",
  "nodes": [
    {
      "id": "start",
      "type": "start",
      "data": {
        "title": "开始",
        "inputsSchema": {
          "type": "object",
          "properties": {
            "query": {
              "type": "string"
            }
          }
        }
      }
    },
    {
      "id": "clean",
      "type": "code",
      "data": {
        "title": "Python 文本清洗",
        "script": {
          "language": "python",
          "content": "import json\n\n\ndef main(params):\n    text = str(params.get('text', '')).strip()\n    print(json.dumps({'level': 'log', 'msg': 'cleaned text: ' + text}), file=__import__('sys').stderr)\n    return {\n        'cleaned': text,\n        'length': len(text),\n    }\n"
        },
        "inputsSchema": {
          "type": "object",
          "properties": {
            "text": {
              "type": "string"
            }
          }
        },
        "inputsValues": {
          "text": {
            "type": "ref",
            "content": [
              "start",
              "query"
            ]
          }
        },
        "outputsSchema": {
          "type": "object",
          "properties": {
            "cleaned": {
              "type": "string"
            },
            "length": {
              "type": "number"
            }
          }
        },
        "sandboxDriver": "dify"
      }
    },
    {
      "id": "check",
      "type": "condition",
      "data": {
        "title": "长度判断",
        "cases": [
          {
            "when": {
              "left": {
                "type": "ref",
                "content": [
                  "clean",
                  "length"
                ]
              },
              "op": "gte",
              "right": {
                "type": "constant",
                "content": 10
              }
            },
            "branch": "long"
          },
          {
            "branch": "short"
          }
        ]
      }
    },
    {
      "id": "score",
      "type": "code",
      "data": {
        "title": "JS 打分(长文本)",
        "script": {
          "language": "javascript",
          "content": "/** 长文本:按词数打分 */\nasync function main({ params }) {\n  const words = String(params.text || '').split(/\\s+/).filter(Boolean);\n  console.error(JSON.stringify({ level: 'log', msg: `word count = ${words.length}` }));\n  return { score: Math.min(100, words.length * 8) };\n}\n"
        },
        "inputsSchema": {
          "type": "object",
          "properties": {
            "text": {
              "type": "string"
            }
          }
        },
        "inputsValues": {
          "text": {
            "type": "ref",
            "content": [
              "clean",
              "cleaned"
            ]
          }
        },
        "outputsSchema": {
          "type": "object",
          "properties": {
            "score": {
              "type": "number"
            }
          }
        },
        "sandboxDriver": "docker"
      }
    },
    {
      "id": "reply",
      "type": "code",
      "data": {
        "title": "PHP 兜底回复(短文本)",
        "script": {
          "language": "php",
          "content": "<?php\n// 短文本:直接生成回复\nfunction main(array $params): array\n{\n    $text = (string) ($params['text'] ?? '');\n    fwrite(STDERR, json_encode(['level' => 'log', 'msg' => 'short text fallback'], JSON_UNESCAPED_UNICODE) . \"\\n\");\n    return ['reply' => sprintf('收到短文本「%s」,已转人工处理', $text)];\n}\n"
        },
        "inputsSchema": {
          "type": "object",
          "properties": {
            "text": {
              "type": "string"
            }
          }
        },
        "inputsValues": {
          "text": {
            "type": "ref",
            "content": [
              "clean",
              "cleaned"
            ]
          }
        },
        "outputsSchema": {
          "type": "object",
          "properties": {
            "reply": {
              "type": "string"
            }
          }
        },
        "sandboxDriver": "process"
      }
    },
    {
      "id": "end",
      "type": "end",
      "data": {
        "title": "结束(汇聚)",
        "inputsSchema": {
          "type": "object",
          "properties": {
            "score": {
              "type": "number"
            },
            "reply": {
              "type": "string"
            }
          }
        },
        "inputsValues": {
          "score": {
            "type": "ref",
            "content": [
              "score",
              "score"
            ]
          },
          "reply": {
            "type": "ref",
            "content": [
              "reply",
              "reply"
            ]
          }
        }
      }
    }
  ],
  "edges": [
    {
      "from": "start",
      "to": "clean"
    },
    {
      "from": "clean",
      "to": "check"
    },
    {
      "from": "check",
      "to": "score",
      "fromPort": "long"
    },
    {
      "from": "check",
      "to": "reply",
      "fromPort": "short"
    },
    {
      "from": "score",
      "to": "end"
    },
    {
      "from": "reply",
      "to": "end"
    }
  ]
}