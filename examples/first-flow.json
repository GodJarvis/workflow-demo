{
  "id": "first-flow",
  "comment": "示例工作流:start → Python 清洗 → 条件分支(长/短文本) → JS 打分 | PHP 兜底 → end 汇聚。演示 ref/template 引用、多语言代码节点、分支裁剪(skipped)、汇聚调度",
  "nodes": [
    {
      "id": "start",
      "type": "start",
      "data": {
        "title": "开始",
        "inputsSchema": {
          "type": "object",
          "properties": {
            "query": { "type": "string" }
          }
        }
      }
    },
    {
      "id": "clean",
      "type": "code",
      "data": {
        "title": "Python 文本清洗",
        "script": {
          "language": "python",
          "content": "import json\n\n\ndef main(params):\n    text = str(params.get('text', '')).strip()\n    print(json.dumps({'level': 'log', 'msg': 'cleaned text: ' + text}), file=__import__('sys').stderr)\n    return {\n        'cleaned': text,\n        'length': len(text),\n    }\n"
        },
        "inputsSchema": {
          "type": "object",
          "properties": {
            "text": { "type": "string" }
          }
        },
        "inputsValues": {
          "text": { "type": "ref", "content": ["start", "query"] }
        },
        "outputsSchema": {
          "type": "object",
          "properties": {
            "cleaned": { "type": "string" },
            "length": { "type": "number" }
          }
        }
      }
    },
    {
      "id": "check",
      "type": "condition",
      "data": {
        "title": "长度判断",
        "cases": [
          {
            "when": {
              "left": { "type": "ref", "content": ["clean", "length"] },
              "op": "gte",
              "right": { "type": "constant", "content": 10 }
            },
            "branch": "long"
          },
          { "branch": "short" }
        ]
      }
    },
    {
      "id": "score",
      "type": "code",
      "data": {
        "title": "JS 打分(长文本)",
        "script": {
          "language": "javascript",
          "content": "/** 长文本:按词数打分 */\nasync function main({ params }) {\n  const words = String(params.text || '').split(/\\s+/).filter(Boolean);\n  console.error(JSON.stringify({ level: 'log', msg: `word count = ${words.length}` }));\n  return { score: Math.min(100, words.length * 8) };\n}\n"
        },
        "inputsSchema": {
          "type": "object",
          "properties": {
            "text": { "type": "string" }
          }
        },
        "inputsValues": {
          "text": { "type": "ref", "content": ["clean", "cleaned"] }
        },
        "outputsSchema": {
          "type": "object",
          "properties": {
            "score": { "type": "number" }
          }
        }
      }
    },
    {
      "id": "reply",
      "type": "code",
      "data": {
        "title": "PHP 兜底回复(短文本)",
        "script": {
          "language": "php",
          "content": "<?php\n// 短文本:直接生成回复\nfunction main(array $params): array\n{\n    $text = (string) ($params['text'] ?? '');\n    fwrite(STDERR, json_encode(['level' => 'log', 'msg' => 'short text fallback'], JSON_UNESCAPED_UNICODE) . \"\\n\");\n    return ['reply' => sprintf('收到短文本「%s」,已转人工处理', $text)];\n}\n"
        },
        "inputsSchema": {
          "type": "object",
          "properties": {
            "text": { "type": "string" }
          }
        },
        "inputsValues": {
          "text": { "type": "ref", "content": ["clean", "cleaned"] }
        },
        "outputsSchema": {
          "type": "object",
          "properties": {
            "reply": { "type": "string" }
          }
        }
      }
    },
    {
      "id": "end",
      "type": "end",
      "data": {
        "title": "结束(汇聚)",
        "inputsSchema": {
          "type": "object",
          "properties": {
            "score": { "type": "number" },
            "reply": { "type": "string" }
          }
        },
        "inputsValues": {
          "score": { "type": "ref", "content": ["score", "score"] },
          "reply": { "type": "ref", "content": ["reply", "reply"] }
        }
      }
    }
  ],
  "edges": [
    { "from": "start", "to": "clean" },
    { "from": "clean", "to": "check" },
    { "from": "check", "to": "score", "fromPort": "long" },
    { "from": "check", "to": "reply", "fromPort": "short" },
    { "from": "score", "to": "end" },
    { "from": "reply", "to": "end" }
  ]
}
