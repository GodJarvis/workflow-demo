    {
      "id": "format",
      "type": "code",
      "data": {
        "title": "PHP 格式化",
        "script": {
          "language": "php",
          "content": "<?php\n// PHP 用户代码约定:function main(array $params): array\nfunction main(array $params): array\n{\n    $kind = (string) ($params['kind'] ?? 'unknown');\n    fwrite(STDERR, json_encode(['level' => 'log', 'msg' => '[php] kind=' . $kind], JSON_UNESCAPED_UNICODE) . \"\\n\");\n    return ['summary' => sprintf('分类结果「%s」', $kind)];\n}\n"
        },
        "inputsSchema": {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string"
            }
          }
