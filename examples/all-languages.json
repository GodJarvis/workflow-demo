        "script": {
          "language": "python",
          "content": "import json, sys\n\ndef main(params):\n    text = str(params.get('text', '')).strip()\n    print(json.dumps({'level': 'log', 'msg': '[py] cleaned: ' + text}), file=sys.stderr)\n    return {'cleaned': text, 'length': len(text)}\n"
        },
