        "script": {
          "language": "javascript",
          "content": "/** 加工:补全上下文标签 */\nasync function main({ params }) {\n  const t = String(params.text || '');\n  console.error(JSON.stringify({ level: 'log', msg: '[js] enriched' }));\n  return { enriched: '[' + t + '] via polyglot pipeline' };\n}\n"
        },
        "inputsSchema": {
          "type": "object",
          "properties": {
            "text": {
              "type": "string"
            }
          }
