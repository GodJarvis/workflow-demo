      "type": "code",
      "data": {
        "title": "Golang 分类(编译型)",
        "sandboxDriver": "docker",
        "script": {
          "language": "golang",
          "content": "package main\n\nimport \"fmt\"\n\n// Go 用户代码约定:完整合法文件,定义导出的 Main(与 wire.go 同 package 链接)\nfunc Main(params map[string]any) (map[string]any, error) {\n\ttext := fmt.Sprintf(\"%v\", params[\"enriched\"])\n\tkind := \"short\"\n\tif len(text) > 20 {\n\t\tkind = \"long\"\n\t}\n\treturn map[string]any{\"kind\": kind, \"length\": len(text)}, nil\n}\n"
        },
        "inputsSchema": {
          "type": "object",
